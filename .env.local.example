# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for `npm run seed`, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — demo data for `npm run seed`
# SEED_THERAPIST_EMAIL=therapist@example.com
# SEED_THERAPIST_PASSWORD=your-secure-password

# ---------------------------------------------------------------------------
# Vercel deployment checklist
# ---------------------------------------------------------------------------
# 1. Import this repo in Vercel and set the env vars above for Production.
# 2. In Supabase → Authentication → URL Configuration, add:
#      Site URL:          https://your-app.vercel.app
#      Redirect URLs:     https://your-app.vercel.app/**
#                          http://localhost:3000/**
# 3. Run supabase/migrations/001_initial_schema.sql in the Supabase SQL editor.
# 4. Set NEXT_PUBLIC_APP_URL to your Vercel domain so patient magic links work.
# 5. Deploy — PWA manifest and service worker are generated at build time.
